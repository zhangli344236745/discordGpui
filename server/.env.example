# 复制成 .env 后按需修改；不填则使用 app/config.py 的默认值
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 生产必须换掉：至少 32 字节
JWT_SECRET=dev-only-change-me-please-32bytes!

ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=26214400
MEDIA_BASE_URL=http://127.0.0.1:8080/media

# LiveKit：换成自己的 key/secret 后，客户端拿回来的 token 才能真正连上 SFU
LIVEKIT_URL=wss://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-1234
LIVEKIT_TOKEN_TTL_HOURS=2

RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW_SECONDS=5
