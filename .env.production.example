# 复制为 .env 并按环境修改；不要把真实密钥提交到仓库。

# 数据库：生产用 Postgres，开发默认 SQLite
DATABASE_URL=postgresql+asyncpg://discord:discord@postgres:5432/discord

# 实时广播：多实例必填；单进程可留空
REDIS_URL=redis://redis:6379/0

# 附件存储：当前实现默认本地磁盘；S3/MinIO 配置为 P0 预留
UPLOAD_DIR=/data/uploads
S3_ENDPOINT=http://minio:9000
# 客户端可达的预签名地址（本地开发用 127.0.0.1）
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=discord
S3_SECRET_KEY=discord-secret
S3_BUCKET=attachments

# 安全配置：必须替换
JWT_SECRET=change-me-in-production-please-32bytes
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# LiveKit：P3 真实语音使用
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxx
LIVEKIT_WEBHOOK_SECRET=whsec_xxx

# 对外地址
MEDIA_BASE_URL=http://127.0.0.1:8080/media
